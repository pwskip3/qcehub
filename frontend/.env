# 🚀 QCEHub Environment Configuration

# Backend API URL (Default: Cloudflare Workers)
NEXT_PUBLIC_API_BASE_URL=https://api.qcehub.com

# AI Model API Keys (Replace with actual API keys)
NEXT_PUBLIC_AI_DEEPSEEK_KEY=your-deepseek-api-key
NEXT_PUBLIC_AI_MISTRAL_KEY=your-mistral-api-key
NEXT_PUBLIC_AI_OPENAI_KEY=your-openai-api-key

# Quantum Security Configuration
NEXT_PUBLIC_ENABLE_PQC=true
NEXT_PUBLIC_PQC_ALGORITHM=CRYSTALS-Dilithium

# Authentication & Security
NEXT_PUBLIC_JWT_SECRET=your-secure-jwt-secret

# Deployment Environment (vercel/aws/cloudflare)
NEXT_PUBLIC_DEPLOYMENT_ENV=vercel

# Enable Analytics Tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true
